# ─────────────────────────────────────────────────────────────────────────────
# RecoveryAI — Root Environment Variables Example
# Copy to backend/.env and frontend/.env.local respectively.
# ─────────────────────────────────────────────────────────────────────────────

# Backend: Supabase PostgreSQL connection string (async via asyncpg)
SUPABASE_DB_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Backend: Google Gemini API Key (for LLM intent parser & dunning copy)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Backend: Sarvam AI API Key (for saaras:v3 STT & bulbul:v3 TTS)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# Frontend: Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
