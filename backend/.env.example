# ─────────────────────────────────────────────────────────────────────────────
# RecoveryAI — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string (async via asyncpg)
SUPABASE_DB_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# Google Gemini API Key (used for LLM-powered recovery decision engine)
GEMINI_API_KEY=

# Sarvam AI API Key (used for multilingual Indian-language voice/SMS nudges)
SARVAM_API_KEY=
